---
import ArchiveLedger from "@/glass/components/ArchiveLedger.astro";
import GlassShell from "@/glass/layouts/GlassShell.astro";
import { getSortedPosts } from "@/utils/content-utils";

const posts = await getSortedPosts();
---

<GlassShell title="记录归档" description="按年份浏览全部公开写作记录。">
	<ArchiveLedger posts={posts} />
</GlassShell>
