---
import path from "node:path";
import ArcadeCover from "@/arcade/components/ArcadeCover.astro";
import ArcadeLicense from "@/arcade/components/ArcadeLicense.astro";
import ArcadeTOC from "@/arcade/components/ArcadeTOC.astro";
import PostStats from "@/arcade/components/PostStats.astro";
import ArcadeShell from "@/arcade/layouts/ArcadeShell.astro";
import { gitHubEditConfig, licenseConfig, profileConfig, siteConfig } from "@/config";
import { getPostNavigation, toPostSummary } from "@/utils/content-core";
import { getSortedPosts } from "@/utils/content-utils";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getDir, getPostUrlBySlug } from "@/utils/url-utils";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
	const entries = await getSortedPosts();
	return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const allPosts = await getSortedPosts();
const navigation = getPostNavigation(allPosts, entry.slug);
const summary = toPostSummary(entry);
const { Content, headings, remarkPluginFrontmatter } = await entry.render();
const postPath = getPostUrlBySlug(entry.slug);
const description = entry.data.description || remarkPluginFrontmatter.excerpt || entry.data.title;
const briefCode = String(allPosts.findIndex((post) => post.slug === entry.slug) + 1).padStart(3, "0");
const hasCover = Boolean(entry.data.image?.trim());

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description,
	author: { "@type": "Person", name: profileConfig.name, url: Astro.site },
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	dateModified: formatDateToYYYYMMDD(entry.data.updated || entry.data.published),
	inLanguage: entry.data.lang ? entry.data.lang.replace("_", "-") : siteConfig.lang.replace("_", "-"),
	url: new URL(postPath, Astro.site),
};
---

<ArcadeShell
	title={entry.data.title}
	description={description}
	lang={entry.data.lang || siteConfig.lang}
	article
	hasToc={headings.length > 0}
>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

	<section class="arcade-article-page">
		<header class="arcade-article-brief" data-brief-code={briefCode}>
			<span class="hud-kicker">MISSION BRIEF / {summary.type}</span>
			<h1 data-pagefind-meta="title">{entry.data.title}</h1>
			<p>{description}</p>
			<div class="arcade-brief-meta">
				<span><Icon name="material-symbols:calendar-month-outline" /> 发布 {formatDateToYYYYMMDD(entry.data.published)}</span>
				{entry.data.updated && <span><Icon name="material-symbols:update" /> 更新 {formatDateToYYYYMMDD(entry.data.updated)}</span>}
				<span><Icon name="material-symbols:notes" /> {remarkPluginFrontmatter.words} 字</span>
				<span><Icon name="material-symbols:schedule-outline" /> {remarkPluginFrontmatter.minutes} 分钟</span>
				<span><Icon name="material-symbols:folder-outline" /> {summary.category}</span>
			</div>
			{entry.data.tags.length > 0 && (
				<div class="arcade-brief-tags" aria-label="文章标签">
					{entry.data.tags.map((tag) => <span class="arcade-type-chip">#{tag}</span>)}
				</div>
			)}
			<PostStats path={postPath} label={`${entry.data.title} 累计统计`} />
		</header>

		{hasCover && (
			<ArcadeCover
				src={entry.data.image}
				basePath={path.join("content/posts/", getDir(entry.id))}
				alt={`${entry.data.title} 封面`}
			/>
		)}

		<article class="arcade-reader-frame" data-frame-label="ARTICLE // READ MODE" data-article-body>
			<div class="arcade-prose" data-pagefind-body>
				<Content />
			</div>
		</article>

		<section class="arcade-article-actions" aria-label="文章操作">
			<div class="arcade-action-panel">
				<span class="hud-kicker">FEEDBACK</span>
				<strong>发现错误或想继续讨论？</strong>
				<p>可以直接联系维护者，或在 GitHub 查看并编辑对应 Markdown。</p>
				<div class="arcade-action-links">
					<a href="/contact/"><Icon name="material-symbols:alternate-email" /> 联系</a>
					{gitHubEditConfig.enable && (
						<a href={`${gitHubEditConfig.baseUrl}/${entry.slug}.md`} target="_blank" rel="noopener noreferrer">
							<Icon name="fa6-brands:github" /> 编辑源文件
						</a>
					)}
				</div>
			</div>
			<div class="arcade-action-panel">
				<span class="hud-kicker">KEYBOARD</span>
				<strong>任务快捷键</strong>
				<p><kbd>Ctrl K</kbd> 搜索，<kbd>Alt ←</kbd> 新一篇，<kbd>Alt →</kbd> 旧一篇。</p>
				<div class="arcade-action-links">
					<a href="#arcade-main"><Icon name="material-symbols:vertical-align-top" /> 返回简报</a>
					<a href="/archive/"><Icon name="material-symbols:inventory-2-outline" /> 全部归档</a>
				</div>
			</div>
		</section>

		{licenseConfig.enable && <ArcadeLicense title={entry.data.title} pubDate={entry.data.published} />}

		<nav class="arcade-article-nav" aria-label="相邻文章">
			{navigation.newer ? (
				<a href={navigation.newer.url} data-nav-newer>
					<span>← NEWER MISSION</span>
					<strong>{navigation.newer.title}</strong>
				</a>
			) : <span></span>}
			{navigation.older ? (
				<a href={navigation.older.url} data-nav-older>
					<span>OLDER MISSION →</span>
					<strong>{navigation.older.title}</strong>
				</a>
			) : <span></span>}
		</nav>

		<section
			class="arcade-giscus-zone"
			data-giscus-host
			data-repo="MingToneFurry/blog-discuss"
			data-repo-id="R_kgDOQytHUg"
			data-category="Announcements"
			data-category-id="DIC_kwDOQytHUs4C0gFg"
			data-mapping="pathname"
			data-strict="0"
			data-reactions-enabled="1"
			data-emit-metadata="0"
			data-input-position="top"
			data-theme="preferred_color_scheme"
			data-lang="zh-CN"
			data-loading="lazy"
			aria-label="文章评论"
		></section>
	</section>

	<ArcadeTOC slot="toc" headings={headings} />
</ArcadeShell>
