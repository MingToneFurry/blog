---
import ArticleContext from "@/glass/components/ArticleContext.astro";
import ArticleReader from "@/glass/components/ArticleReader.astro";
import GlassShell from "@/glass/layouts/GlassShell.astro";
import { profileConfig, siteConfig } from "@/config";
import { getPostNavigation, toPostSummary } from "@/utils/content-core";
import { getSortedPosts } from "@/utils/content-utils";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";

export async function getStaticPaths() {
	const posts = await getSortedPosts();
	return posts.map((entry) => ({
		params: { slug: entry.slug },
		props: {
			entry,
			navigation: getPostNavigation(posts, entry.slug),
		},
	}));
}

const { entry, navigation } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await entry.render();
const summary = toPostSummary(entry);
const canonical = new URL(summary.url, Astro.site).toString();
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: summary.title,
	description: summary.description || summary.title,
	url: canonical,
	datePublished: formatDateToYYYYMMDD(summary.published),
	dateModified: summary.updated ? formatDateToYYYYMMDD(summary.updated) : undefined,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	inLanguage: summary.lang ? summary.lang.replace("_", "-") : siteConfig.lang.replace("_", "-"),
};
---

<GlassShell
	title={summary.title}
	description={summary.description || remarkPluginFrontmatter.excerpt}
	lang={summary.lang || siteConfig.lang}
	article
>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
	<ArticleReader
		entry={entry}
		summary={summary}
		navigation={navigation}
		words={remarkPluginFrontmatter.words}
		minutes={remarkPluginFrontmatter.minutes}
		excerpt={remarkPluginFrontmatter.excerpt}
		canonical={canonical}
	>
		<Content />
	</ArticleReader>
	<Fragment slot="context">
		<ArticleContext
			headings={headings}
			summary={summary}
			navigation={navigation}
			words={remarkPluginFrontmatter.words}
			minutes={remarkPluginFrontmatter.minutes}
		/>
	</Fragment>
</GlassShell>
