---
import FriendNetwork from "@/glass/components/FriendNetwork.astro";
import GlassShell from "@/glass/layouts/GlassShell.astro";
import type { Friend } from "@/types/data";

const friends = Object.values(
	import.meta.glob<Friend>("@/data/friends/*.json", {
		eager: true,
		import: "default",
	}),
).filter((friend) => friend?.name && friend?.url);
---

<GlassShell title="友链网络" description="由仓库 JSON 记录生成的友链目录。">
	<FriendNetwork friends={friends} />
</GlassShell>
