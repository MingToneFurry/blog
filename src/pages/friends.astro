---
import { siteConfig } from "@/config";
import type { Friend } from "@/types/data";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";

const friends = Object.values(
	import.meta.glob<Friend>("@/data/friends/*.json", {
		eager: true,
		import: "default",
	}),
);
---

<MainGridLayout title="友链">
    <section class="card-base friends-directory">
        <div class="mono-section-head">
            <h1>Link directory</h1>
            <span class="mono-badge">{String(friends.length).padStart(2, "0")} PEERS</span>
        </div>

        <!-- 申请友链 -->
        <div class="friends-intro">
            <span class="mono-badge">SUBMIT</span>
            <p class="text-sm text-black/60 dark:text-white/60">
                如果您也想加入友链名单，<a target="_blank" href="https://github.com/MingToneFurry/blog/tree/main/src/data/friends" class="transition link text-[var(--primary)] font-medium underline">请点击这里提交</a>
            </p>
        </div>
        <div class="friends-grid grid grid-cols-1 md:grid-cols-2">
            {friends.map((friend, index) => (
                <a href={friend.url} target="_blank" class="friend-card">
                    <div class="friend-index">{String(index + 1).padStart(2, "0")}</div>
                    <div class="friend-avatar relative overflow-hidden" style={`--theme-hue: ${siteConfig.themeColor.hue}`}>
                            <div class="loading-bar absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-32 h-1 bg-gray-200 dark:bg-gray-700 z-10 rounded-full overflow-hidden">
                                <div class="loading-progress h-full w-8 bg-[var(--ui-fg-muted)] animate-loading-progress rounded-full"></div>
                            </div>
                            <img src={friend.avatar} loading="lazy" class="w-full h-full object-cover opacity-0 transition-opacity duration-500" alt={`${friend.name}的头像`} onload="this.style.opacity='1'; this.parentElement.querySelector('.loading-bar').style.opacity='0';"/>
                    </div>
                    <div class="friend-copy">
                        <div class="font-bold text-black dark:text-white">{friend.name}</div>
                        <div class="text-sm text-black/50 dark:text-white/50">{friend.description}</div>
                    </div>
                    <div class="friend-open">[OPEN] ↗</div>
                </a>
            ))}
        </div>
    </section>
</MainGridLayout>

<style>
    .friend-card {
        display: grid;
        grid-template-columns: 2rem 3rem minmax(0, 1fr) auto;
        align-items: center;
        gap: .875rem;
        min-height: 5.5rem;
        padding: .875rem 1rem;
        border-width: 0 1px 1px 0 !important;
        transition: background var(--ui-dur-fast) var(--ui-ease), border-color var(--ui-dur-fast) var(--ui-ease), transform var(--ui-dur-fast) var(--ui-ease);
    }
    
    .friend-card:active {
        scale: .98;
        background-color: var(--btn-regular-bg-active);
    }
    
    .friend-card:hover {
        background-color: var(--ui-surface-2) !important;
    }

    .friends-intro { padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--ui-line); }
    .friends-intro p { display: inline; margin-left: .75rem; }
    .friends-grid { gap: 0 !important; }
    .friend-index, .friend-open { color: var(--ui-fg-subtle); font-family: "JetBrains Mono Variable", ui-monospace, monospace; font-size: .625rem; letter-spacing: .06em; }
    .friend-avatar { width: 3rem; height: 3rem; border: 1px solid var(--ui-line); }
    .friend-copy { min-width: 0; }
    .friend-copy .font-bold { letter-spacing: -.02em; }
    .friend-copy .text-sm { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .friend-open { opacity: .45; }
    .friend-card:hover .friend-open { opacity: 1; }

    @media (max-width: 640px) {
        .friend-card { grid-template-columns: 1.5rem 2.5rem minmax(0, 1fr); }
        .friend-avatar { width: 2.5rem; height: 2.5rem; }
        .friend-open { display: none; }
    }
    
    .friend-card:hover .font-bold {
        color: var(--btn-content);
    }
    
    .friend-card:hover .text-sm {
    @apply text-gray-700 dark:text-white;
    }

    .friend-card .font-bold,
    .friend-card .text-sm {
        transition-property: color;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        transition-duration: 0.15s;
    }

    .loading-bar {
        transition: opacity 0.5s ease-out;
    }

    @keyframes loading-progress {
        0% {
            transform: translateX(-100%);
        }
        100% {
            transform: translateX(400%);
        }
    }

    .animate-loading-progress {
        animation: loading-progress 1.5s ease-in-out infinite;
    }
</style>
