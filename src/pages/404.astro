---
import JournalShell from "@/mono/layouts/JournalShell.astro";
---

<JournalShell title="页面未找到" tocLabel="错误页索引" backgroundMode="edge">
	<section class="journal-error" aria-labelledby="journal-error-title">
		<p class="journal-error__code journal-mono" aria-hidden="true">404</p>
		<p class="journal-kicker">[MISSING PAGE]</p>
		<h1 id="journal-error-title">这一页未被刊印。</h1>
		<p>请求的地址不存在、已移动，或从未进入本刊目录。你仍可从首页或完整归档继续阅读。</p>
		<div class="journal-error__links">
			<a href="/">返回首页</a>
			<a href="/archive/">查看完整归档</a>
		</div>
	</section>
</JournalShell>
