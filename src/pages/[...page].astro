---
import type { GetStaticPaths } from "astro";
import type { MarkdownHeading } from "astro";
import { PAGE_SIZE } from "../constants/constants";
import JournalHome from "../mono/components/JournalHome.astro";
import JournalShell from "../mono/layouts/JournalShell.astro";
import { getSortedPosts } from "../utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;
const homeHeadings: MarkdownHeading[] = [
	{ depth: 2, slug: "lead", text: page.currentPage === 1 ? "刊首文章" : `第 ${page.currentPage} 页` },
	{ depth: 2, slug: "entries", text: "编辑索引" },
	{ depth: 2, slug: "publication-index", text: "出版物索引" },
];
---

<JournalShell
	title={page.currentPage === 1 ? undefined : `第 ${page.currentPage} 页`}
	tocHeadings={homeHeadings}
	tocLabel="本期目录"
	backgroundMode="cover"
>
	<JournalHome page={page} />
</JournalShell>
