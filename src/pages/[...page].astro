---
import type { GetStaticPaths } from "astro";
import ActiveMission from "@/arcade/components/ActiveMission.astro";
import ArcadePagination from "@/arcade/components/ArcadePagination.astro";
import ModuleDeck from "@/arcade/components/ModuleDeck.astro";
import PageHeader from "@/arcade/components/PageHeader.astro";
import TransmissionCard from "@/arcade/components/TransmissionCard.astro";
import ArcadeShell from "@/arcade/layouts/ArcadeShell.astro";
import { PAGE_SIZE } from "@/constants/constants";
import { partitionPinnedPosts } from "@/utils/content-core";
import { getSortedPosts } from "@/utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	const { pinned, regular } = partitionPinnedPosts(allBlogPosts);
	return paginate(regular, {
		pageSize: PAGE_SIZE,
		props: { pinnedMissions: pinned },
	});
}) satisfies GetStaticPaths;

const { page, pinnedMissions } = Astro.props;
const isFirstPage = page.currentPage === 1;
const absoluteStart = pinnedMissions.length + page.start + 1;
---

<ArcadeShell title={isFirstPage ? undefined : `任务传输 第 ${page.currentPage} 页`}>
	<section class="arcade-module-page" data-home-console>
		{isFirstPage ? (
			<section
				class:list={[
					"arcade-mission-scene",
					{ "has-no-missions": pinnedMissions.length === 0, "has-multiple-missions": pinnedMissions.length > 1 },
				]}
				aria-labelledby="field-node-title"
			>
				<div class="arcade-scene-coordinates">SCENE // API.FURRY.IST</div>
				<div class="arcade-scene-intro">
					<span class="hud-kicker">PERSONAL FIELD NODE / ONLINE</span>
					<h1 id="field-node-title">
						<span class="arcade-scene-title-line arcade-scene-title-lead">探索</span>
						<span class="arcade-scene-title-line">记录 / 连接</span>
					</h1>
					<p>
						这里是 MingTone 的数字任务节点：生活记录、Cloudflare 实验、Furry 文化与沿途信号，
						都以可检索的传输形式持续归档。
					</p>
					<div class="arcade-scene-actions">
						<a class="arcade-primary-action" href="#transmissions">读取最新传输 <span aria-hidden="true">↓</span></a>
						<button class="arcade-secondary-action" type="button" data-command-open="search">打开命令搜索 <span aria-hidden="true">⌘</span></button>
					</div>
				</div>
				{pinnedMissions.length > 0 && (
					<div class="arcade-active-mission-deck" aria-label="置顶任务">
						{pinnedMissions.map((entry, index) => (
							<ActiveMission entry={entry} priority={index + 1} index={index + 1} />
						))}
					</div>
				)}
			</section>
		) : (
			<PageHeader
				kicker={`TRANSMISSION DECK / PAGE ${String(page.currentPage).padStart(2, "0")}`}
				title={`任务传输 ${String(page.currentPage).padStart(2, "0")}`}
				description="继续扫描按优先级与发布时间排序的历史信号，所有任务都可直接进入。"
				code={String(page.currentPage).padStart(3, "0")}
			/>
		)}

		<section id="transmissions" aria-labelledby="transmission-heading">
			<header class="arcade-section-heading">
				<div>
					<span class="hud-kicker">LIVE FEED / SORTED</span>
					<h2 id="transmission-heading">Transmissions</h2>
				</div>
				<span>PAGE_{String(page.currentPage).padStart(2, "0")} / {String(page.data.length).padStart(2, "0")} SIGNALS</span>
			</header>
			<div class="arcade-transmission-grid">
				{page.data.map((entry, index) => (
					<TransmissionCard entry={entry} index={absoluteStart + index} />
				))}
			</div>
			<ArcadePagination page={page} />
		</section>

		{isFirstPage && (
			<section aria-labelledby="module-heading">
				<header class="arcade-section-heading">
					<div>
						<span class="hud-kicker">SYSTEM ACCESS / MODULES</span>
						<h2 id="module-heading">Module Rail</h2>
					</div>
					<span>05 ACCESS POINTS</span>
				</header>
				<ModuleDeck />
			</section>
		)}
	</section>
</ArcadeShell>
