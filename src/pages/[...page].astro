---
import type { GetStaticPaths } from "astro";
import GlassPagination from "@/glass/components/GlassPagination.astro";
import HomeContext from "@/glass/components/HomeContext.astro";
import HomeObservatory from "@/glass/components/HomeObservatory.astro";
import GlassShell from "@/glass/layouts/GlassShell.astro";
import { PAGE_SIZE } from "@/constants/constants";
import { toPostSummary } from "@/utils/content-core";
import { getSortedPosts } from "@/utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const posts = await getSortedPosts();
	return paginate(posts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const allPosts = await getSortedPosts();
const title = page.currentPage === 1 ? undefined : `观测记录 · 第 ${page.currentPage} 页`;
---

<GlassShell title={title}>
	<HomeObservatory posts={page.data} pageNumber={page.currentPage} lastPage={page.lastPage} />
	<GlassPagination page={page} />
	<Fragment slot="context">
		<HomeContext posts={allPosts.map(toPostSummary)} />
	</Fragment>
</GlassShell>
