---

import { getSortedPosts } from "../utils/content-utils";
import { getPostUrlBySlug } from "../utils/url-utils";

interface Props {
	keyword?: string;
}

let posts = await getSortedPosts();

const groups: { year: number; posts: typeof posts }[] = (() => {
	const groupedPosts = posts.reduce(
		(grouped: { [year: number]: typeof posts }, post) => {
			const year = post.data.published.getFullYear();
			if (!grouped[year]) {
				grouped[year] = [];
			}
			grouped[year].push(post);
			return grouped;
		},
		{},
	);

	// convert the object to an array
	const groupedPostsArray = Object.keys(groupedPosts).map((key) => ({
		year: Number.parseInt(key),
		posts: groupedPosts[Number.parseInt(key)],
	}));

	// sort years by latest first
	groupedPostsArray.sort((a, b) => b.year - a.year);
	return groupedPostsArray;
})();

function formatDate(date: Date) {
	const month = (date.getMonth() + 1).toString().padStart(2, "0");
	const day = date.getDate().toString().padStart(2, "0");
	return `${month}-${day}`;
}
---

<section class="archive-panel card-base">
    <div class="mono-section-head">
        <h1>Chronological index</h1>
        <span class="mono-badge">{String(posts.length).padStart(2, "0")} ENTRIES</span>
    </div>
    {
        groups.map(group => (
            <div class="archive-group">
                <div class="flex flex-row w-full items-center h-[3.75rem]">
                    <div class="archive-year w-[20%] md:w-[14%] transition text-2xl font-bold text-right text-75">{group.year}</div>
                    <div class="w-[12%] md:w-[8%]">
                        <div class="h-3 w-3 border border-[var(--ui-line-strong)] bg-[var(--ui-surface)] mx-auto z-50"></div>
                    </div>
                    <div class="w-[68%] md:w-[78%] transition text-left text-50 mono-mono text-xs">[{String(group.posts.length).padStart(2, "0")}] ARTICLES</div>
                </div>
                {group.posts.map(post => (
                    <a href={getPostUrlBySlug(post.slug)}
                       aria-label={post.data.title}
                       class="archive-entry group btn-plain !block min-h-12 w-full hover:text-[initial]"
                    >
                        <div class="flex flex-row justify-start items-center h-full">
                            <!-- date -->
                            <time datetime={post.data.published.toISOString()} class="w-[20%] md:w-[14%] transition text-xs text-right text-50 mono-mono">
                                {formatDate(post.data.published)}
                            </time>
                            <!-- dot and line -->
                            <div class="w-[12%] md:w-[8%] relative dash-line h-full flex items-center">
                                <div class="archive-tick transition-all mx-auto"></div>
                            </div>
                            <!-- post title -->
                            <div class="w-[68%] md:max-w-[64%] md:w-[64%] text-left font-medium
                                group-hover:translate-x-1 transition-all group-hover:text-[var(--ui-fg)]
                                text-75 pr-8 whitespace-nowrap overflow-ellipsis overflow-hidden"
                            >
                                    {post.data.title}
                            </div>
                            <!-- tag list -->
                            <div class="hidden md:block md:w-[14%] text-right pr-4 text-xs transition mono-mono
                            whitespace-nowrap overflow-ellipsis overflow-hidden
                            text-30"
                            >[OPEN]</div>
                        </div>
                    </a>
                ))}
            </div>
        ))
    }
</section>

<style>
    .archive-group + .archive-group { border-top: 1px solid var(--ui-line); }
    .archive-tick { width: 5px; height: 5px; border: 1px solid var(--ui-line-strong); background: var(--ui-surface); z-index: 2; }
    .archive-entry:hover .archive-tick { height: 1.25rem; background: var(--ui-accent); }
    .dash-line::before { width: 0; left: 50%; border-left: 1px solid var(--ui-line); transform: none; }
</style>
