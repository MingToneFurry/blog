---
import type { CollectionEntry } from "astro:content";
import { getPostUrlBySlug } from "@utils/url-utils";
import PostCard from "./PostCard.astro";

const { page } = Astro.props;

let delay = 0;
const interval = 50;
---

<div class="post-list transition flex flex-col bg-transparent gap-4 mb-4">

    {page.data.map((entry: CollectionEntry<"posts">) => (
        <PostCard
                entry={entry}
                title={entry.data.title}
                published={entry.data.published}
                updated={entry.data.updated}
                url={getPostUrlBySlug(entry.slug)}
                image={entry.data.image}
                description={entry.data.description}
                draft={entry.data.draft}
                class:list="onload-animation"
                style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
        ></PostCard>
    ))}
</div>

<script>
    const wait = (delay) => new Promise((resolve) => setTimeout(resolve, delay));

    async function waitForUmamiHelper() {
        for (let attempt = 0; attempt < 40; attempt++) {
            if (typeof window.fetchUmamiStats === 'function') return true;
            await wait(100);
        }
        return false;
    }

    async function fetchCardStats(card) {
        if (card.dataset.statsLoaded === 'true') return;

        const baseUrl = card.dataset.statsBaseUrl;
        const shareId = card.dataset.statsShareId;
        const timezone = card.dataset.statsTimezone;
        const path = card.dataset.statsUrl;
        if (!baseUrl || !shareId || !path) return;

        let lastError;
        for (let attempt = 0; attempt < 3; attempt++) {
            try {
                const stats = await window.fetchUmamiStats(baseUrl, shareId, { path, timezone });
                const views = (stats.pageviews && stats.pageviews.value) || stats.pageviews || 0;
                const visitors = (stats.visitors && stats.visitors.value) || stats.visitors || 0;
                const viewsElement = card.querySelector('[data-stat-kind="views"]');
                const visitorsElement = card.querySelector('[data-stat-kind="visitors"]');
                if (viewsElement) viewsElement.textContent = views;
                if (visitorsElement) visitorsElement.textContent = visitors;
                card.dataset.statsLoaded = 'true';
                return;
            } catch (error) {
                lastError = error;
                await wait(attempt === 0 ? 400 : 900);
            }
        }
        console.error('Failed to load card stats for', path, lastError);
    }

    async function loadPostCardStats() {
        if (!(await waitForUmamiHelper())) return;
        const cards = Array.from(document.querySelectorAll('.post-card-stats'));
        let nextIndex = 0;

        async function worker() {
            while (nextIndex < cards.length) {
                const card = cards[nextIndex++];
                if (!(card instanceof HTMLElement)) continue;
                await fetchCardStats(card);
            }
        }

        await Promise.all(Array.from({ length: Math.min(4, cards.length) }, worker));
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', loadPostCardStats, { once: true });
    } else {
        loadPostCardStats();
    }
    document.addEventListener('content:replace', loadPostCardStats);
</script>
