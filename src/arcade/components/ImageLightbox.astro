---
import { Icon } from "astro-icon/components";
---

<div
	class="arcade-lightbox"
	data-image-lightbox
	role="dialog"
	aria-modal="true"
	aria-labelledby="arcade-lightbox-title"
	aria-hidden="true"
	hidden
>
	<div class="arcade-lightbox-backdrop" data-lightbox-close aria-hidden="true"></div>
	<section class="arcade-lightbox-frame cut-card">
		<header class="arcade-lightbox-toolbar">
			<div>
				<strong id="arcade-lightbox-title">图片预览</strong>
				<span data-lightbox-counter role="status" aria-live="polite" aria-atomic="true">IMAGE 01 / 01</span>
			</div>
			<nav aria-label="图片预览控制">
				<button type="button" data-lightbox-prev aria-label="查看上一张图片" title="上一张">
					<Icon name="material-symbols:arrow-back" />
				</button>
				<button type="button" data-lightbox-next aria-label="查看下一张图片" title="下一张">
					<Icon name="material-symbols:arrow-forward" />
				</button>
				<a
					data-lightbox-original
					href="/"
					target="_blank"
					rel="noopener"
					aria-label="在新标签页打开原图"
					title="打开原图"
				>
					<Icon name="material-symbols:open-in-new" />
				</a>
				<button type="button" data-lightbox-close aria-label="关闭图片预览" title="关闭">
					<Icon name="material-symbols:close" />
				</button>
			</nav>
		</header>
		<figure class="arcade-lightbox-stage">
			<img data-lightbox-image alt="" decoding="async" />
			<figcaption data-lightbox-caption hidden></figcaption>
		</figure>
	</section>
</div>
