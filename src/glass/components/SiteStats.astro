---
interface Props {
	scope: "site" | "post";
	path?: string;
	label?: string;
	compact?: boolean;
}

const {
	scope,
	path,
	label = scope === "site" ? "全站累计观测" : "本文累计观测",
	compact = false,
} = Astro.props;
---

<div
	class:list={["glass-stats", { "glass-stats-compact": compact }]}
	data-blog-stats
	data-stats-scope={scope}
	data-stats-path={scope === "post" ? path : undefined}
	data-stats-state="idle"
	aria-busy="false"
>
	<p>{label}</p>
	<div class="glass-stat-grid">
		<div>
			<span data-stats-value="pageviews" data-stats-state="idle" aria-live={compact ? "off" : "polite"}>--</span>
			<small>累计浏览 PV</small>
		</div>
		<div>
			<span data-stats-value="visitors" data-stats-state="idle" aria-live={compact ? "off" : "polite"}>--</span>
			<small>累计访客 UV</small>
		</div>
	</div>
</div>
