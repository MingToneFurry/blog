---
import path from "node:path";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { imageFallbackConfig } from "@/config";
import { url } from "@/utils/url-utils";

interface Props {
	src: string;
	alt?: string;
	basePath?: string;
	loading?: "eager" | "lazy";
}

const {
	src,
	alt = "",
	basePath = "/",
	loading = "lazy",
} = Astro.props;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http://") ||
	src.startsWith("https://") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

let localImage: ImageMetadata | undefined;
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>("../../**", { import: "default" });
	const normalizedPath = path
		.normalize(path.join("../../", basePath, src))
		.replace(/\\/g, "/");
	const loader = files[normalizedPath];
	if (loader) localImage = await loader();
}

const resolvedSrc = isPublic ? url(src) : src;
const fallbackSrc = imageFallbackConfig.enable && resolvedSrc.includes(imageFallbackConfig.originalDomain)
	? resolvedSrc.replace(imageFallbackConfig.originalDomain, imageFallbackConfig.fallbackDomain)
	: "";
---

{isLocal && localImage ? (
	<Image src={localImage} alt={alt} loading={loading} />
) : (
	<img
		src={resolvedSrc}
		alt={alt}
		loading={loading}
		decoding="async"
		onerror={fallbackSrc ? `this.onerror=null;this.src='${fallbackSrc}';` : undefined}
	/>
)}
