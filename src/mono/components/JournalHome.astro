---
import { profileConfig } from "@/config";
import { PAGE_SIZE } from "@/constants/constants";
import { DEFAULT_POST_CATEGORY, DEFAULT_POST_TYPE, toPostSummary } from "@/utils/content-core";
import { getSortedPosts } from "@/utils/content-utils";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getPostUrlBySlug } from "@/utils/url-utils";
import type { CollectionEntry } from "astro:content";
import type { Page } from "astro";
import JournalPagination from "./JournalPagination.astro";
import JournalStats from "./JournalStats.astro";

interface Props {
	page: Page<CollectionEntry<"posts">>;
}

const { page } = Astro.props;
const allPosts = await getSortedPosts();
const allSummaries = allPosts.map(toPostSummary);
const offset = (page.currentPage - 1) * PAGE_SIZE;
const indexedPosts = page.data.map((entry, index) => ({ entry, number: offset + index + 1 }));

const leadIndex = page.currentPage === 1
	? page.data.findIndex((entry) => entry.data.pinned || Boolean(entry.data.featured))
	: -1;
const normalizedLeadIndex = page.currentPage === 1 ? Math.max(0, leadIndex) : -1;
const lead = normalizedLeadIndex >= 0 ? page.data[normalizedLeadIndex] : null;
const entries = indexedPosts.filter((_, index) => index !== normalizedLeadIndex);

const categoryCounts = new Map<string, number>();
const seriesCounts = new Map<string, number>();
const yearCounts = new Map<number, number>();
for (const post of allSummaries) {
	categoryCounts.set(post.category, (categoryCounts.get(post.category) || 0) + 1);
	if (post.series) seriesCounts.set(post.series, (seriesCounts.get(post.series) || 0) + 1);
	const year = post.published.getFullYear();
	yearCounts.set(year, (yearCounts.get(year) || 0) + 1);
}

const categories = [...categoryCounts.entries()].sort((a, b) => b[1] - a[1]);
const series = [...seriesCounts.entries()].sort((a, b) => b[1] - a[1]);
const years = [...yearCounts.entries()].sort((a, b) => b[0] - a[0]);
---

<div class="journal-home">
	{lead ? (
		<section id="lead" class="journal-lead" aria-labelledby="journal-lead-title">
			<div>
				<p class="journal-lead__label">[COVER STORY / {String(normalizedLeadIndex + 1).padStart(2, "0")}]</p>
				<h1 id="journal-lead-title">
					<a href={getPostUrlBySlug(lead.slug)}>{lead.data.title}</a>
				</h1>
				{lead.data.description && <p class="journal-lead__description">{lead.data.description}</p>}
			</div>

			<div class="journal-lead__meta">
				<dl class="journal-lead__facts">
					<div>
						<dt>发布日期</dt>
						<dd><time datetime={lead.data.published.toISOString()}>{formatDateToYYYYMMDD(lead.data.published)}</time></dd>
					</div>
					<div>
						<dt>内容类型</dt>
						<dd>{lead.data.type || DEFAULT_POST_TYPE}</dd>
					</div>
					<div>
						<dt>分类</dt>
						<dd>{lead.data.category || DEFAULT_POST_CATEGORY}</dd>
					</div>
					<div>
						<dt>状态</dt>
						<dd>{lead.data.pinned ? "PINNED" : "FEATURED"}</dd>
					</div>
				</dl>
				<JournalStats scope="post" path={getPostUrlBySlug(lead.slug)} label={`${lead.data.title}累计统计`} />
			</div>
		</section>
	) : (
		<header id="lead" class="journal-page-header">
			<p class="journal-kicker">[ISSUE PAGE {String(page.currentPage).padStart(2, "0")}]</p>
			<h1>继续阅读。</h1>
			<p>本页按出版顺序收录第 {offset + 1}—{offset + page.data.length} 篇文章。</p>
		</header>
	)}

	<section id="entries" aria-labelledby="journal-entries-title">
		<div class="journal-section-rule">
			<h2 id="journal-entries-title">编辑索引</h2>
			<span>{String(page.data.length).padStart(2, "0")} ENTRIES / PAGE {String(page.currentPage).padStart(2, "0")}</span>
		</div>

		<ol class="journal-entry-list">
			{entries.map(({ entry, number }) => (
				<li>
					<article class="journal-entry">
						<span class="journal-entry__number">{String(number).padStart(2, "0")}</span>
						<div class="journal-entry__body">
							<a class="journal-entry__title" href={getPostUrlBySlug(entry.slug)}>{entry.data.title}</a>
							{entry.data.description && <p class="journal-entry__description">{entry.data.description}</p>}
							<div class="journal-entry__meta">
								<time datetime={entry.data.published.toISOString()}>{formatDateToYYYYMMDD(entry.data.published)}</time>
								<span>[{entry.data.category || DEFAULT_POST_CATEGORY}]</span>
								<span>[{entry.data.type || DEFAULT_POST_TYPE}]</span>
								{entry.data.tags.slice(0, 2).map((tag) => <span>#{tag}</span>)}
							</div>
						</div>
						<JournalStats scope="post" path={getPostUrlBySlug(entry.slug)} label={`${entry.data.title}累计统计`} />
					</article>
				</li>
			))}
		</ol>

		<JournalPagination page={page} />
	</section>

	<section id="publication-index" class="journal-publication-index" aria-label="出版物索引">
		<section>
			<h2>分类</h2>
			<ul>
				{categories.map(([category, count]) => <li><span>{category}</span><span>{String(count).padStart(2, "0")}</span></li>)}
			</ul>
		</section>
		<section>
			<h2>系列</h2>
			<ul>
				{series.length > 0
					? series.map(([seriesName, count]) => <li><span>{seriesName}</span><span>{String(count).padStart(2, "0")}</span></li>)
					: <li><span>尚未编入系列</span><span>--</span></li>}
			</ul>
		</section>
		<section>
			<h2>年份</h2>
			<ul>
				{years.map(([year, count]) => <li><span>{year}</span><span>{String(count).padStart(2, "0")}</span></li>)}
			</ul>
		</section>
	</section>

	<section class="journal-editor-note" aria-labelledby="journal-editor-title">
		{profileConfig.avatar && <img src={profileConfig.avatar} alt={`${profileConfig.name}的头像`} loading="lazy" />}
		<div>
			<p class="journal-kicker">[EDITOR'S NOTE]</p>
			<h2 id="journal-editor-title">{profileConfig.name}</h2>
			<p>{profileConfig.bio || "独立编辑"}。记录生活、Cloudflare、音乐与互联网中的偶然发现。</p>
		</div>
		<div class="journal-editor-note__links">
			<a href="/about/">关于编辑 →</a>
			<a href="/friends/">友链目录 →</a>
			<a href="/archive/">完整归档 →</a>
		</div>
	</section>
</div>
