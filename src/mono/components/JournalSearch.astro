<dialog id="journal-search" class="journal-dialog journal-search" aria-labelledby="journal-search-title">
	<div class="journal-dialog__header">
		<div>
			<span class="journal-kicker">[INDEX SEARCH]</span>
			<h2 id="journal-search-title">检索刊物</h2>
		</div>
		<form method="dialog">
			<button class="journal-icon-button" type="submit" aria-label="关闭搜索">关闭</button>
		</form>
	</div>

	<form class="journal-search__form" data-journal-search-form role="search">
		<label for="journal-search-input">标题、摘要或关键词</label>
		<div class="journal-search__field">
			<input
				id="journal-search-input"
				name="query"
				type="search"
				autocomplete="off"
				placeholder="输入后检索 RSS 索引"
				data-journal-search-input
			/>
			<button type="submit">检索</button>
		</div>
	</form>

	<p class="journal-search__status journal-mono" data-journal-search-status aria-live="polite">
		等待输入。搜索索引来自 /rss.xml。
	</p>
	<ol class="journal-search__results" data-journal-search-results></ol>
	<noscript>
		<p>搜索需要 JavaScript；你仍可前往 <a href="/archive/">完整归档</a> 浏览全部文章。</p>
	</noscript>
</dialog>
