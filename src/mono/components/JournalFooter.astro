---
import { profileConfig, siteConfig } from "@/config";

const currentYear = new Date().getFullYear();
---

<footer class="journal-footer">
	<div class="journal-footer__statement">
		<p class="journal-kicker">[COLOPHON]</p>
		<p>{siteConfig.description}</p>
	</div>

	<div class="journal-footer__links">
		<div>
			<strong>编辑</strong>
			<a href="/about/">关于 {profileConfig.name}</a>
			<a href="/contact/">联系方式</a>
			{profileConfig.links.map((link) => (
				<a href={link.url} target="_blank" rel="noopener noreferrer">{link.name} ↗</a>
			))}
		</div>
		<div>
			<strong>网络</strong>
			<a href="/friends/">友链目录</a>
			<a href="https://stats.uptimerobot.com/6zqrufirxf" target="_blank" rel="noopener noreferrer">运行状态 ↗</a>
			<a href="https://cloud.umami.is/analytics/us/share/HdVBrs2TcRJ2LJd4" target="_blank" rel="noopener noreferrer">公开统计 ↗</a>
		</div>
		<div>
			<strong>出版</strong>
			<a href="/rss.xml" target="_blank" rel="noopener noreferrer">RSS ↗</a>
			<a href="/sitemap-index.xml" target="_blank" rel="noopener noreferrer">Sitemap ↗</a>
			<a href="/privacy/">隐私政策</a>
		</div>
	</div>

	<div class="journal-footer__legal journal-mono">
		<span>© 2024—{currentYear} {profileConfig.name}</span>
		<a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-NC-SA 4.0 ↗</a>
		<a href="https://icp.gov.moe/?keyword=20242144" target="_blank" rel="noopener noreferrer">萌ICP备20242144号 ↗</a>
		<span>BUILT WITH ASTRO</span>
	</div>
</footer>
